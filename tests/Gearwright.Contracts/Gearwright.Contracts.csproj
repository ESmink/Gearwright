<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>Gearwright.Contracts</AssemblyName>
    <VintageStoryPath Condition="'$(VintageStoryPath)' == '' and '$(VINTAGE_STORY)' != ''">$(VINTAGE_STORY)</VintageStoryPath>
    <VintageStoryPath Condition="'$(VintageStoryPath)' == '' and Exists('$(APPDATA)\Vintagestory\VintagestoryAPI.dll')">$(APPDATA)\Vintagestory</VintageStoryPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="PumpCircuitFixture.cs" />
    <Compile Include="..\..\code\**\*.cs" LinkBase="Runtime" />
    <Compile Include="PumpRuntimeFixture.cs" />
    <Compile Include="ReciprocatingDriveFixture.cs" />
    <Compile Include="LargeBellowsFixture.cs" />
    <Compile Include="BellowsRendererFixture.cs" />
    <Compile Include="PumpTimingFixture.cs" />
    <Compile Include="PipePressureFixture.cs" />
    <Compile Include="PipeAddonFixture.cs" />
    <Compile Include="PipeSupportFixture.cs" />
    <Compile Include="PipeRoomFixture.cs" />
    <Compile Include="HydraulicRuntimeFixture.cs" />
    <Reference Include="VSSurvivalMod">
      <HintPath>$(VintageStoryPath)\Mods\VSSurvivalMod.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="VSEssentials">
      <HintPath>$(VintageStoryPath)\Mods\VSEssentials.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="VintagestoryLib">
      <HintPath>$(VintageStoryPath)\VintagestoryLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VintageStoryPath)\VintagestoryAPI.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(VintageStoryPath)\Lib\0Harmony.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(VintageStoryPath)\Lib\Newtonsoft.Json.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="protobuf-net">
      <HintPath>$(VintageStoryPath)\Lib\protobuf-net.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SkiaSharp">
      <HintPath>$(VintageStoryPath)\Lib\SkiaSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(VintageStoryPath)\assets\game\shaders\standard.fsh"
          Link="sdk\standard.fsh" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\gearwright\shapes\block\lateral-crank-one-sided.json"
          Link="runtime-shapes\lateral-crank-one-sided.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\gearwright\shapes\block\lateral-crank-through.json"
          Link="runtime-shapes\lateral-crank-through.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\gearwright\shapes\block\reciprocating-pump-mechanism.json"
          Link="runtime-shapes\reciprocating-pump-mechanism.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CheckVintageStoryPath" BeforeTargets="ResolveReferences"
          Condition="!Exists('$(VintageStoryPath)\VintagestoryAPI.dll') or !Exists('$(VintageStoryPath)\Mods\VSSurvivalMod.dll') or !Exists('$(VintageStoryPath)\Mods\VSEssentials.dll') or !Exists('$(VintageStoryPath)\VintagestoryLib.dll') or !Exists('$(VintageStoryPath)\Lib\Newtonsoft.Json.dll') or !Exists('$(VintageStoryPath)\Lib\protobuf-net.dll') or !Exists('$(VintageStoryPath)\Lib\0Harmony.dll')">
    <Error Text="Vintage Story was not found. The runtime and compatibility contracts require a complete Vintage Story 1.22.3 installation." />
  </Target>
</Project>
